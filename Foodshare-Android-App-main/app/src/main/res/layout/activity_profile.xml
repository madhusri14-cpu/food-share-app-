<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#24834A"
            android:gravity="center"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name: Loading..."
            android:textSize="18sp"
            android:padding="14dp"/>

        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email: Loading..."
            android:textSize="18sp"
            android:padding="14dp"/>

        <TextView
            android:id="@+id/tvProfileRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Role: Loading..."
            android:textSize="18sp"
            android:padding="14dp"/>

        <TextView
            android:id="@+id/tvProfilePhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone: Loading..."
            android:textSize="18sp"
            android:padding="14dp"/>

        <TextView
            android:id="@+id/tvProfileLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location: Loading..."
            android:textSize="18sp"
            android:padding="14dp"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Logout"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:backgroundTint="#C62828"
            android:layout_marginTop="30dp"/>

    </LinearLayout>
</ScrollView>
